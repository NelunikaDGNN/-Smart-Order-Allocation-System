# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:Nelunika@localhost:5432/smart_order_allocation

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10

# ML classifier (python subprocess)
ML_PYTHON_BIN=./ml/venv/Scripts/python.exe
ML_SCRIPT_PATH=./ml/predict.py
ML_CONFIDENCE_THRESHOLD=0.55

# CORS
FRONTEND_ORIGIN=http://localhost:5173
